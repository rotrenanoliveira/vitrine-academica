{
  "name": "@vitrine-academica/api",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "db:generate": "pnpm env:load drizzle-kit generate",
    "db:migrate": "pnpm env:load drizzle-kit migrate",
    "db:studio": "pnpm env:load drizzle-kit studio",
    "db:seed": "pnpm env:load tsx src/seed.ts",
    "test:unit:watch": "dotenv -e ../../.env.local -- vitest --project unit",
    "test:unit:run": "dotenv -e ../../.env.local -- vitest run --project unit",
    "test:e2e:watch": "dotenv -e ../../.env.local -- vitest --project e2e",
    "test:e2e:run": "dotenv -e ../../.env.local -- vitest run --project e2e",
    "dev": "pnpm env:load tsx --watch src/infra/http/server.ts",
    "env:load": "dotenv -e ../../.env --",
    "start": "pnpm env:load node dist/server.mjs",
    "postinstall": "pnpm build",
    "build": "tsup",
    "postbuild": "pnpm db:generate && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitrine-academica/tsconfig": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "unplugin-swc": "^1.5.11",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^7.0.0",
    "nanoid": "^6.0.1",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "resend": "^6.26.0",
    "tsup": "^8.5.1",
    "zod": "^4.5.4"
  }
}