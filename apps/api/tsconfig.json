{
  "extends": "@vitrine-academica/tsconfig/node.json",
  "include": ["src/**/*", "tests/**/*", "@types/**/*"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "types": ["@faker-js/faker", "vitest/globals"],
    "paths": {
      "@/*": ["./src/*"],
      "@tests/*": ["./tests/*"]
    }
  }
}
